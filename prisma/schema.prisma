// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Status {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String   @id
  username     String   @unique
  name         String
  email        String   @unique
  contact      String   @unique
  password     String
  role         Role
  joinedStatus Status
  createdAt    DateTime
  updatedAt    DateTime

  address       Address?
  apartments    UserApartmentLink[]
  complaints    Complaints[]
  polls         Polls[]
  notices       Notices[]
  notifications Notifications[]
  comments      Comments[]

  @@index([email])
  @@index([joinedStatus])
}

model Apartment {
  id                    String   @id
  name                  String
  address               String
  description           String
  officeNumber          String
  buildingNumberFrom    Int
  buildingNumberTo      Int
  floorCountPerBuilding Int
  unitCountPerFloor     Int
  createdAt             DateTime
  updatedAt             DateTime

  User       UserApartmentLink[]
  complaints Complaints[]
  polls      Polls[]
  notices    Notices[]
}

model UserApartmentLink {
  userId      String
  apartmentId String

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  apartment Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)

  @@id([userId, apartmentId])
  @@index([apartmentId])
}

model Address {
  userId        String  @id
  isHouseHolder Boolean
  unit          String
  building      String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  SUPERADMIN
  ADMIN
  USER
}

model Comments {
  id        String   @id
  createdAt DateTime
  updatedAt DateTime
  content   String

  userId String
  author User   @relation(fields: [userId], references: [id])

  complaintId String?
  complaint   Complaints? @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  noticeId String?
  notice   Notices? @relation(fields: [noticeId], references: [id], onDelete: Cascade)
}

model Complaints {
  id           String          @id
  createdAt    DateTime
  updatedAt    DateTime
  title        String
  content      String
  status       ComplaintStatus @default(PENDING)
  isPublic     Boolean         @default(true)
  viewsCount   Int             @default(0)
  apartmentId  String
  apartment    Apartment       @relation(fields: [apartmentId], references: [id])
  userId       String
  complaintant User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  comments Comments[]
}

enum ComplaintStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
}

model Options {
  id        String @id
  title     String
  voteCount Int    @default(0)
  pollId    String
  poll      Polls  @relation(fields: [pollId], references: [id], onDelete: Cascade)
}

model Polls {
  id          String     @id
  createdAt   DateTime
  updatedAt   DateTime
  title       String
  content     String
  status      PollStatus @default(PENDING)
  startDate   DateTime
  endDate     DateTime
  apartmentId String
  apartment   Apartment  @relation(fields: [apartmentId], references: [id])
  building    Int
  userId      String
  author      User       @relation(fields: [userId], references: [id])

  options Options[]
}

enum PollStatus {
  IN_PROGRESS
  PENDING
  CLOSED
}

model Notices {
  id          String         @id
  createdAt   DateTime
  updatedAt   DateTime
  title       String
  content     String
  category    NoticeCategory
  isPinned    Boolean        @default(false)
  viewCount   Int            @default(0)
  apartmentId String
  apartment   Apartment      @relation(fields: [apartmentId], references: [id])
  userId      String
  author      User           @relation(fields: [userId], references: [id])
  comment     Comments[]

  startDate DateTime
  endDate   DateTime
}

enum NoticeCategory {
  MAINTENCE
  URGENT
  COMMUNITY
  VOTING
  BOARD_MEETING
  ETC
}

model Notifications {
  id        String   @id
  createdAt DateTime
  updatedAt DateTime
  content   String
  userId    String
  author    User     @relation(fields: [userId], references: [id])
}
