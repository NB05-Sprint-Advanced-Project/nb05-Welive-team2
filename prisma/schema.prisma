// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  id       String @id
  username String @unique
  password String
  email    String
  contact  String
  role     Role

  admins        AdminOf[]
  residents     Resident[]
  complaints    Complaints[]
  polls         Polls[]
  notices       Notices[]
  notifications Notifications[]
  comments      Comments[]
}

enum Role {
  SUPERADMIN
  ADMIN
  USER
}

model AdminOf {
  id                    String   @id
  createdAt             DateTime
  updatedAt             DateTime
  name                  String
  address               String
  description           String
  officeNumber          String
  buildingNumberFrom    Int
  buildingNumberTo      Int
  floorCountPerBuilding Int
  unitCountPerFloor     Int
  adminId               String
  admin                 Users    @relation(fields: [adminId], references: [id])

  residents  Resident[]
  complaints Complaints[]
  polls      Polls[]
  notices    Notices[]
}

model Resident {
  id            String   @id
  createdAt     DateTime
  updatedAt     DateTime
  name          String
  email         String
  contact       String
  building      Int
  unit          Int
  isHouseholder Boolean
  userId        String
  user          Users    @relation(fields: [userId], references: [id])
  apartmentId   String
  apartment     AdminOf  @relation(fields: [apartmentId], references: [id])
}

model Comments {
  id         String       @id
  createdAt  DateTime
  updatedAt  DateTime
  content    String

  userId     String
  author     Users        @relation(fields: [userId], references: [id])

  complaintId String?
  complaint   Complaints? @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  noticeId   String?
  notice     Notices?     @relation(fields: [noticeId], references: [id], onDelete: Cascade)
}

model Complaints {
  id           String          @id
  createdAt    DateTime
  updatedAt    DateTime
  title        String
  content      String
  status       ComplaintStatus @default(PENDING)
  isPublic     Boolean         @default(true)
  viewsCount    Int             @default(0)
  apartmentId  String
  apartment    AdminOf         @relation(fields: [apartmentId], references: [id])
  userId       String
  complaintant Users           @relation(fields: [userId], references: [id], onDelete: Cascade)

  comments Comments[]
}

enum ComplaintStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
}

model Options{
  id        String @id
  title     String
  voteCount Int @default(0)
  pollId    String
  poll      Polls @relation(fields: [pollId], references: [id], onDelete: Cascade)
}

model Polls {
  id          String     @id
  createdAt   DateTime
  updatedAt   DateTime
  title       String
  content     String
  status      PollStatus @default(PENDING)
  startDate   DateTime
  endDate     DateTime
  apartmentId String
  apartment   AdminOf    @relation(fields: [apartmentId], references: [id])
  building    Int
  userId      String
  author      Users      @relation(fields: [userId], references: [id])

  options     Options[]
}

enum PollStatus {
  IN_PROGRESS
  PENDING
  CLOSED
}

model Notices {
  id          String         @id
  createdAt   DateTime
  updatedAt   DateTime
  title       String
  content     String
  category    NoticeCategory
  isPinned    Boolean        @default(false)
  viewCount   Int            @default(0)
  apartmentId String
  apartment   AdminOf        @relation(fields: [apartmentId], references: [id])
  userId      String
  author      Users          @relation(fields: [userId], references: [id])
  comment     Comments[]     

  startDate   DateTime
  endDate     DateTime
}

enum NoticeCategory {
  MAINTENCE
  URGENT
  COMMUNITY
  VOTING
  BOARD_MEETING
  ETC
}

model Notifications {
  id        String   @id
  createdAt DateTime
  updatedAt DateTime
  content   String
  userId    String
  author    Users    @relation(fields: [userId], references: [id])
}
