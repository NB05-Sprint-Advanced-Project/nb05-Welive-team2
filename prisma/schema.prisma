generator client {
  provider = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String              @id
  username          String              @unique
  name              String
  email             String              @unique
  contact           String              @unique
  avatarUrl         String?
  password          String
  role              String
  joinedStatus      String
  refreshToken      String?
  createdAt         DateTime
  updatedAt         DateTime
  Address           Address?
  Comments          Comments[]
  Complaints        Complaints[]
  Notices           Notices[]
  Notifications     Notifications[]
  Polls             Polls[]
  UserApartmentLink UserApartmentLink[]

  @@index([joinedStatus])
}

model Apartment {
  id                    String              @id
  name                  String
  address               String
  description           String
  officeNumber          String
  buildingNumberFrom    Int
  buildingNumberTo      Int
  floorCountPerBuilding Int
  unitCountPerFloor     Int
  createdAt             DateTime
  updatedAt             DateTime
  complaints            Complaints[]
  notices               Notices[]
  polls                 Polls[]
  UserApartmentLink     UserApartmentLink[]
}

model UserApartmentLink {
  userId      String
  apartmentId String
  apartment   Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, apartmentId])
  @@index([apartmentId])
}

model Address {
  userId        String  @id
  isHouseHolder Boolean
  unit          Int
  building      Int
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Comments {
  id          String      @id
  createdAt   DateTime
  updatedAt   DateTime
  content     String
  userId      String
  complaintId String?
  noticeId    String?
  complaint   Complaints? @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  notice      Notices?    @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  author      User        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([complaintId])
  @@index([noticeId])
}

model Complaints {
  id          String          @id
  createdAt   DateTime
  updatedAt   DateTime
  title       String
  content     String
  status      ComplaintStatus
  isPublic    Boolean
  viewsCount  Int
  apartmentId String
  userId      String
  comments    Comments[]
  apartment   Apartment       @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  complainant User            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([apartmentId])
  @@index([userId])
}

model Options {
  id        String   @id
  title     String
  voteCount Int      @default(0)
  pollId    String
  userIds   String[]
  poll      Polls    @relation(fields: [pollId], references: [id], onDelete: Cascade)
}

model Polls {
  id          String     @id
  createdAt   DateTime
  updatedAt   DateTime
  title       String
  content     String
  status      PollStatus
  startDate   DateTime
  endDate     DateTime
  apartmentId String
  building    Int
  userId      String
  options     Options[]
  apartment   Apartment  @relation(fields: [apartmentId], references: [id])
  author      User       @relation(fields: [userId], references: [id])
}

model Events {
  id        String   @id
  startDate DateTime
  endDate   DateTime
  noticeId  String   @unique
  notice    Notices  @relation(fields: [noticeId], references: [id], onDelete: Cascade)
}

model Notices {
  id          String         @id
  createdAt   DateTime
  updatedAt   DateTime
  title       String
  content     String
  category    NoticeCategory
  isPinned    Boolean
  viewCount   Int
  apartmentId String
  userId      String
  comment     Comments[]
  event       Events?
  apartment   Apartment      @relation(fields: [apartmentId], references: [id])
  author      User           @relation(fields: [userId], references: [id])
}

model Notifications {
  id        String   @id
  createdAt DateTime
  updatedAt DateTime
  content   String
  userId    String
  author    User     @relation(fields: [userId], references: [id])
}

enum ComplaintStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum PollStatus {
  IN_PROGRESS
  PENDING
  CLOSED
}

enum NoticeCategory {
  MAINTENCE
  URGENT
  COMMUNITY
  VOTING
  BOARD_MEETING
  ETC
}
